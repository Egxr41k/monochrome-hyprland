general {
    output_format = "i3bar"
    colors = true
    interval = 2
}

order += "cpu_usage"
order += "memory"
order += "battery all"
order += "tztime local"

cpu_usage {
    format = " CPU: %usage "
}

memory {
    format = " RAM: %used "
    threshold_degraded = "10%"
    format_degraded = " MEMORY LOW: %free "
}

battery all {
    format = " %status %percentage "
}

tztime local {
    format = " %Y-%m-%d %H:%M "
}
